{
  "rules": [
    {
      "pattern": "src/**/*.{cpp,h,hpp,cc}",
      "settings": {
        "language": "cpp",
        "style": {
          "standard": "google",
          "indentation": 2,
          "maxLineLength": 80,
          "braces": "attach",
          "spacesAroundOperators": true,
          "spacesInsideParentheses": false,
          "pointerAlignment": "left"
        },
        "naming": {
          "variables": "snake_case",
          "functions": "UpperCamelCase",
          "classes": "UpperCamelCase",
          "constants": "kConstantCase"
        },
        "comments": {
          "requireDoxygen": true
        },
        "ai": {
          "language": "en",
          "tone": "technical",
          "description": "Use Google C++ Style Guide for code generation and refactoring"
        }
      }
    }
  ],
  "ai": {
    "strictAdherence": true,
    "projectRules": [
      "When deploying to AWS, OpenWrt, and NAS, build/deploy AWS and OpenWrt first because both are aarch64 targets and can share cross-build cache. After those complete, build/deploy NAS.",
      "Project rules must support both Codex and Claude Code. Keep AGENTS.md and CLAUDE.md in sync whenever project operating rules change."
    ],
    "documentation": {
      "autoGenerate": false,
      "autoUpdate": false,
      "description": "Do not generate or update any documentation (README.md, docs, comments) unless explicitly requested by the user"
    }
  }
}
