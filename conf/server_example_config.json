{
    "server_addr": "127.0.0.1",
    "grpc_server_port": 10001,
    "http_server_port": 10003,
    "metric_ratio": 1,
    "metric_interval_sec": 3,
    "discard_ratio": 1,
    "grpc_threads": 3,
    "event_threads": 5,
    "check_interval_seconds": 5,
    "write_logs": true,
    "dns_provider": "cloudflare",
    "cloudflare_api_token": "test",
    "cloudflare_zone_id": "",
    "route53_hosted_zone_id": "test",
    "aws_access_key_id": "test",
    "aws_secret_access_key": "test",
    "aws_region": "ap-southeast-1",
    "certificate_files": [
        "xiedeacc.com.ca.cer",
        "xiedeacc.com.cer",
        "xiedeacc.com.fullchain.cer",
        "xiedeacc.com.key",
        "xiedeacc.com.ocsp.der"
    ],
    "certificate_sync_client_ids": ["home-nas-001"],
    "certificate_path": "/etc/nginx/ssl",
    "ssh_private_key_path": "~/.ssh/id_ed25519",
    "ssh_public_key_path": "~/.ssh/id_ed25519.pub",
    "vlmcsd_enabled": false,
    "vlmcsd_listen_addresses": ["::"]
}
